# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored; THIS file is committed, so it must contain
# placeholders only — never real keys, passwords, or tokens.

# --- Resend (order confirmation email) ---
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Optional. Must be a verified sender/domain on your Resend account.
# The shared onboarding@resend.dev sender only delivers to the email you
# signed up to Resend with — verify your own domain to email real customers.
RESEND_FROM="SkinSnap <onboarding@resend.dev>"

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta (Facebook) Pixel ID from Events Manager, e.g. 1234567890123456
NEXT_PUBLIC_FB_PIXEL_ID=

# --- Supabase (order database) ---
# Dashboard > Project Settings > API
# Leave blank and the store still works — orders just aren't recorded anywhere.
SUPABASE_URL=https://your-project.supabase.co

# ⚠️ Use the SERVICE ROLE key, not the anon key. It bypasses Row Level Security
# and can read every customer's address, so it must stay server-side. Never
# rename this to NEXT_PUBLIC_* — that would ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Shiprocket (COD shipping-rate display only) ---
# Used ONLY to show the real COD shipping charge at checkout. It does NOT
# create orders/shipments in Shiprocket — you manage those in their dashboard.
# Server-side only: Shiprocket logs in with an API-user email/password
# (Settings > API > Create an API user), so these must NEVER be exposed to the
# browser (no NEXT_PUBLIC_ prefix).
# Leave blank and the site simply shows "shipping charges may apply".
SHIPROCKET_EMAIL=api@yourdomain.com
SHIPROCKET_PASSWORD=your_api_user_password

# PIN code you ship FROM — required for courier rate lookups.
SHIPROCKET_PICKUP_PINCODE=380001

# Pickup location nickname exactly as configured in the Shiprocket dashboard
# (Settings > Company > Pickup Addresses). Usually "Primary".
SHIPROCKET_PICKUP_LOCATION=Primary

# --- Mappls / MapmyIndia (checkout address autocomplete + map preview) ---
# Create a free account at https://apis.mappls.com and generate credentials.
# Leave blank and the Street field is just a normal text input (no dropdown/map).
#
# OAuth credentials — server-side only (autosuggest + geocode). Keep secret.
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
#
# Map SDK key — used in the browser to render the map preview. This one is
# public by design (restrict it by referrer/domain in the Mappls console).
NEXT_PUBLIC_MAPPLS_MAP_SDK_KEY=
